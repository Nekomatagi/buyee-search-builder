{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "jp.buyee.searchbuilder",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "app.restartProcess",
    "os.execCommand",
    "os.getPath",
    "os.open",
    "filesystem.writeFile",
    "filesystem.remove",
    "storage.getData",
    "storage.setData",
    "clipboard.writeText",
    "filesystem.writeBinaryFile",
    "window.setAlwaysOnTop",
    "window.setTitle"
  ],
  "globalVariables": {
    "DEEPL_KEY": "",
    "UPDATE_URL": ""
  },
  "modes": {
    "window": {
      "title": "Buyee Search Builder - 🏠TH-JP✈️",
      "width": 560,
      "height": 900,
      "minWidth": 380,
      "minHeight": 600,
      "center": true,
      "icon": "/resources/icons/app.png",
      "enableInspector": false,
      "resizable": true
    }
  },
  "cli": {
    "binaryName": "BuyeeSearch",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/vendor/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
